# Telegram Newsletter Intelligence Bot Configuration

# Telegram User Account (for reading private channel)
# Get these from https://my.telegram.org/apps
TELEGRAM_API_ID=34479664
TELEGRAM_API_HASH=aed0fc36e3d52f8f8ed8efae244c9e63
TELEGRAM_PHONE=+917217448842

# Target Channel (private channel username or numeric ID)
# Format: @channelusername or -100xxxxxxxxxx
# Example: @Economic_Times_Epapers or https://t.me/Economic_Times_Epapers
TARGET_CHANNEL=@Economic_Times_Epapers

# Telegram Bot (for delivering reports)
# Create via @BotFather
BOT_TOKEN=7990401985:AAFl964l-06rqk4Z79UuNFUc-jJeYaxgvjw
REPORT_CHAT_ID=5034238230

# LLM Configuration (using your FCC proxy)
# MUST be a publicly accessible HTTPS URL (GitHub Actions cannot reach localhost)
# Option 1: Cloudflare Tunnel (free) - run: cloudflared tunnel --url http://localhost:8082
# Option 2: ngrok (free) - run: ngrok http 8082
# Option 3: OpenRouter free tier - https://openrouter.ai/api/v1
LLM_BASE_URL=http://host.docker.internal:8082/v1
LLM_API_KEY=dummy
LLM_MODEL=open_router/nvidia/nemotron-3-super-120b-a12b

# Processing settings
MAX_MESSAGES_PER_RUN=50
DAYS_BACK=1
MIN_PDF_SIZE_KB=10
SESSION_NAME=newsletter_session
