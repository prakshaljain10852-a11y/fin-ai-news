# Telegram Newsletter Intelligence Bot Configuration
# Copy to .env and fill in your values

# Telegram User Account (for reading private channel)
# Get these from https://my.telegram.org/apps
TELEGRAM_API_ID=your_api_id_here
TELEGRAM_API_HASH=your_api_hash_here
TELEGRAM_PHONE=+91xxxxxxxxxx  # Your phone with country code

# Target Channel (private channel username or numeric ID)
# Format: @channelusername or -100xxxxxxxxxx
# Example: @Economic_Times_Epapers or https://t.me/Economic_Times_Epapers
TARGET_CHANNEL=@Economic_Times_Epapers

# Telegram Bot (for delivering reports)
# Create via @BotFather
BOT_TOKEN=your_bot_token_here
REPORT_CHAT_ID=your_personal_chat_id  # Numeric ID of your private chat with bot

# LLM Configuration (using your FCC proxy)
LLM_BASE_URL=http://host.docker.internal:8082/v1  # Adjust for GitHub Actions
LLM_API_KEY=dummy
LLM_MODEL=open_router/nvidia/nemotron-3-super-120b-a12b

# Processing settings
MAX_MESSAGES_PER_RUN=50
DAYS_BACK=1
MIN_PDF_SIZE_KB=10